# Never expose this value through NEXT_PUBLIC_* variables.
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openai/gpt-4o-mini
NEXT_PUBLIC_APP_URL=http://localhost:6969
DATABASE_PATH=./data/sime.db
AUTH_SECRET=replace-with-at-least-32-random-characters
# Optional dedicated HMAC secret for signed ID-card QR verification tokens.
ID_CARD_SECRET=replace-with-another-32-random-character-secret
ADMIN_EMAIL=admin@sime.local
ADMIN_PASSWORD=ChangeMe123!
SUPERADMIN_EMAIL=superadmin@sime.local
SUPERADMIN_PASSWORD=SuperAdmin123!
# Optional demo-account overrides. Always change these on a public deployment.
TEACHER_PASSWORD=Teacher123!
STUDENT_PASSWORD=Student123!
PARENT_PASSWORD=Parent123!
SAMPLE_ADMIN_PASSWORD=SampleAdmin123!
